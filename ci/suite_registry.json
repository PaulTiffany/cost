{
  "_meta": {
    "purpose": "Maps each blocking layer and L9 sub-check into a named suite. The certificate orchestrator emits a per-suite roll-up alongside the legacy layers[] array. Layer numbers are preserved as legacy aliases for one transition release; new development should reference suite names instead.",
    "schema_version": 2,
    "introduced": "2026-05-04",
    "rationale_source": "Gemini collaborator note (notetoclaude2.json, 'plan' section): standard test taxonomy makes it easier to add supplementary checks without renumbering or debating where they fit. Migration is additive: layers[] stays in the cert payload; suites[] is added.",
    "policy": "A check is mapped to exactly one suite. The suite owns the question being asked. Sub-checks inherit their parent suite from this registry, not from the layer that wraps them.",
    "last_expansion": "2026-05-04 second pass: BIS gap-fill from Gemini taxonomy review"
  },
  "suites": {
