#!/bin/sh
# Pre-commit hook: run the claim certificate's structural layers
# before allowing a commit to land. Catches regressions in main.tex
# or the registry that would FAIL the certificate.
#
# Install with:
#   cp ci/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# To bypass once (e.g. WIP commit): git commit --no-verify
#
# What runs: only the structural layers (L1, L2, L4) — these are
# fast (<5 sec total) and gate the certificate verdict. L3 (body
# sweep) and L5 (figure values) are advisory and skipped here to
# keep commits fast; run `python ci/claim_certificate.py` for the
# full picture.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "=== pre-commit: claim certificate structural layers ==="

failed=0

if ! python ci/claim_audit.py --tier all > /tmp/claim_audit.out 2>&1; then
    echo "[FAIL] L1 audit (claim_audit.py --tier all)"
    tail -10 /tmp/claim_audit.out
    failed=1
else
    echo "[OK]   L1 audit"
fi

if ! python ci/claim_audit_validator.py > /tmp/claim_validator.out 2>&1; then
    echo "[FAIL] L2 validator (claim_audit_validator.py)"
    tail -10 /tmp/claim_validator.out
    failed=1
else
    echo "[OK]   L2 validator"
fi

if ! python ci/figure_lineage_check.py > /tmp/figure_lineage.out 2>&1; then
    echo "[FAIL] L4 figure lineage (figure_lineage_check.py)"
    tail -10 /tmp/figure_lineage.out
    failed=1
else
    echo "[OK]   L4 figure lineage"
fi

if ! python ci/citation_integrity_check.py > /tmp/citation_integrity.out 2>&1; then
    echo "[FAIL] L7 citation integrity (citation_integrity_check.py)"
    tail -10 /tmp/citation_integrity.out
    failed=1
else
    echo "[OK]   L7 citation integrity"
fi

if ! python ci/link_integrity_check.py > /tmp/link_integrity.out 2>&1; then
    echo "[FAIL] L8 link integrity (link_integrity_check.py)"
    tail -10 /tmp/link_integrity.out
    failed=1
else
    echo "[OK]   L8 link integrity"
fi

if ! python ci/cross_claim_consistency_check.py > /tmp/cross_claim.out 2>&1; then
    echo "[FAIL] L9 cross-claim consistency (cross_claim_consistency_check.py)"
    tail -10 /tmp/cross_claim.out
    failed=1
else
    echo "[OK]   L9 cross-claim consistency"
fi

if ! python ci/bib_entry_check.py > /tmp/bib_entry.out 2>&1; then
    echo "[FAIL] L10 bib entry check (bib_entry_check.py)"
    tail -10 /tmp/bib_entry.out
    failed=1
else
    echo "[OK]   L10 bib entry check"
fi

if ! python ci/script_integrity_check.py > /tmp/script_integrity.out 2>&1; then
    echo "[FAIL] L11 script integrity (script_integrity_check.py)"
    tail -10 /tmp/script_integrity.out
    failed=1
else
    echo "[OK]   L11 script integrity"
fi

if ! python ci/build_equivalence_check.py --quick > /tmp/build_equiv.out 2>&1; then
    echo "[FAIL] L12 build equivalence quick (build_equivalence_check.py --quick)"
    tail -10 /tmp/build_equiv.out
    failed=1
else
    echo "[OK]   L12 build equivalence (quick mode)"
fi

if ! python ci/cross_tree_consistency_check.py > /tmp/cross_tree.out 2>&1; then
    echo "[FAIL] L13 cross-tree consistency (cross_tree_consistency_check.py)"
    tail -10 /tmp/cross_tree.out
    failed=1
else
    echo "[OK]   L13 cross-tree consistency"
fi

if ! python ci/illustration_lineage_check.py > /tmp/illustration_lineage.out 2>&1; then
    echo "[FAIL] L14 illustration lineage (illustration_lineage_check.py)"
    tail -10 /tmp/illustration_lineage.out
    failed=1
else
    echo "[OK]   L14 illustration lineage"
fi

if ! python ci/claim_data_ties_check.py > /tmp/claim_data_ties.out 2>&1; then
    echo "[FAIL] L15 data-tied claims (claim_data_ties_check.py)"
    tail -10 /tmp/claim_data_ties.out
    failed=1
else
    echo "[OK]   L15 data-tied claims"
fi

if [ $failed -ne 0 ]; then
    echo ""
    echo "Pre-commit blocked: a structural layer failed."
    echo "Fix the issue above, or bypass once with: git commit --no-verify"
    echo "Run 'python ci/claim_certificate.py' for the full diagnosis."
    exit 1
fi

echo "All structural layers PASS. Commit proceeding."
exit 0
